# Database (Neon)
DATABASE_URL=postgresql://user:password@host.neon.tech/git_wayback?sslmode=require

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Vercel Blob (for screenshots)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for the cron-only maintenance endpoints. Unset = they 404.
CRON_SECRET=

# Repos directory for cloning
REPOS_DIR=.repos
