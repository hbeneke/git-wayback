# Database (Neon) — required, the app will not boot without it.
DATABASE_URL=postgresql://user:password@host.neon.tech/git_wayback?sslmode=require

# GitHub API token. Optional, but unauthenticated requests are capped at 60/hour
# against 5000/hour, and the repo page spends several per view. Needs no scopes
# for public repositories.
GITHUB_TOKEN=

# Upstash Redis (rate limiting). Optional in development; in production the API
# fails closed with a 503 when these are missing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token for the cron-only maintenance endpoints. Unset = they 404.
CRON_SECRET=

# Salt for the per-day visitor hash stored in repo_visits. Unset falls back to a
# constant, which leaves the hash enumerable over the IPv4 space.
VISITOR_ID_SALT=
